<?xml version="1.0" encoding="utf-8"?>
<!--
  Lessons hold the teacher's voice. On Android 12 and later, allowBackup="false"
  stops cloud backup but not a device-to-device transfer, so exclude everything
  from both: a local-only lesson must not leave the phone that way either.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
